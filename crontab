# cron 기본 PATH엔 /usr/local/bin(python)이 없어 "python: not found" → 명시.
PATH=/usr/local/bin:/usr/bin:/bin
# 매분: 거래내역 import 폴더 변경 감지 자동 적재(소유주_계좌명_증권사_계좌번호_연도.csv|xlsx).
* * * * * cd /app && python cli.py scan-imports >> /app/data/imports.log 2>&1 || true
# 매일 07:00 (KST): 시세 갱신 + 순자산 스냅샷. 거래내역은 웹 업로드 또는 imports 폴더로 적재.
0 7 * * * cd /app && python cli.py refresh-prices >> /app/data/refresh.log 2>&1 && python cli.py snapshot >> /app/data/refresh.log 2>&1
# 매일 07:20: 거시경제 지표 갱신.
20 7 * * * cd /app && python cli.py macro-refresh >> /app/data/refresh.log 2>&1 || true
# 매일 07:30: 서울 아파트 실거래가 최근 2개월 갱신 + 신규 단지 건축물대장(증분).
30 7 * * * cd /app && python cli.py re-sync --months 2 >> /app/data/refresh.log 2>&1; python cli.py bldg-sync >> /app/data/refresh.log 2>&1 || true
# 매주 월 06:30: 자동완성용 전체 상장종목 캐시 갱신(KRX+미국).
30 6 * * 1 cd /app && python cli.py sync-symbols >> /app/data/refresh.log 2>&1 || true
# 장중(평일 09~15시) 매분: 단타 규칙 평가(모의투자 vts). trading.market_open이 09:00~15:30 게이트.
* 9-15 * * 1-5 cd /app && python cli.py trade-tick >> /app/data/trade.log 2>&1 || true
