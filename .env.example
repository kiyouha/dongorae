# dongorae 스택(이 맥) 환경변수. docker compose가 루트에서 이 파일 하나만 읽는다.
# 이 파일을 .env 로 복사해서 채운다.

# ── 접속 주소 ─────────────────────────────────────────────
# 브라우저가 실제로 치는 주소. 네이버 로그인 콜백이 이 값으로 만들어진다:
#   {AUTH_BASE_URL}/auth/naver/callback  ← developers.naver.com 에 등록돼 있어야 함
# 이 맥만 쓸 거면 http://localhost:8000, 집 안 다른 기기(아이폰 등)도 쓰면 LAN IP.
AUTH_BASE_URL=http://localhost:8000
# 게이트웨이(:8000)를 어디에 바인딩할지. 이 맥에서만 열려면 127.0.0.1 로.
BIND_ADDR=0.0.0.0
# https 리버스프록시 뒤에 두면 1 (세션 쿠키 Secure)
COOKIE_SECURE=0

# ── 아이클라우드 금융 폴더 ──────────────────────────────
# 거래내역(import)과 내보내기(export)를 여기서 직접 읽고 쓴다.
#   {FINANCE_DIR}/거래내역   ← 증권사 파일 넣는 곳(소유주/계좌명/…)
#   {FINANCE_DIR}/정리본  ← 서버가 xlsx로 내보내는 곳
FINANCE_DIR=$HOME/Library/Mobile Documents/com~apple~CloudDocs/home/금융

# ── 네이버 로그인 (developers.naver.com) ──────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 국토교통부 실거래가 서비스키(Decoding, data.go.kr) ────
MOLIT_SERVICE_KEY=

# ── 자동매매: 한국투자증권(KIS) ───────────────────────────
# vts=모의투자(기본). 실전 주문은 KIS_ALLOW_LIVE=1 을 명시해야만 나간다.
KIS_ENV=vts
KIS_APPKEY=
KIS_APPSECRET=
KIS_ACCOUNT=
KIS_ALLOW_LIVE=
